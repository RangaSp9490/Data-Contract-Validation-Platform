# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/data_contract_db
TEST_DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/data_contract_test

# LLM settings. LLM_PROVIDER = openai_compatible | mock
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.2:3b, LLM_API_KEY empty
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

MAX_UPLOAD_MB=50
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
